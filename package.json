{
    "name": "bloom-gamekit-tooling",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^22.13.0 || >=24"
    },
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "check": "npm run format:check && npm run lint",
        "build": "node project/build.mjs",
        "vector-assets:compile": "node modules/vector-assets/scripts/compile.mjs",
        "test:vector-assets": "node modules/vector-assets/tests/compiler.mjs && npm run build && npm run build:previews && node modules/vector-assets/tests/run-browser.mjs",
        "test:vector-assets:world-rendering": "node modules/vector-assets/tests/run-world-rendering.browser.mjs",
        "benchmark:vector-assets-population": "npm run build && node modules/vector-assets/tests/run-browser.mjs --population-timing",
        "test:vector-assets:index-variants": "npm run build && node modules/vector-assets/tests/index-variants.mjs && node modules/vector-assets/tests/run-index-variants.browser.mjs",
        "test:vector-assets:non-scaling-stroke": "npm run build && node modules/vector-assets/tests/run-non-scaling-stroke.browser.mjs",
        "test:rendering:yarn-shader": "npm run build && node modules/rendering/tests/yarn-shader.mjs && node modules/rendering/tests/run-yarn-shader.browser.mjs",
        "test:rendering:vector-gradient-clip": "npm run build && node modules/rendering/tests/run-vector-gradient-clip.browser.mjs",
        "test:rendering:alpha-run-batching": "npm run build && node modules/rendering/tests/run-alpha-run-batching.browser.mjs",
        "test": "node project/test-scenarios.mjs core",
        "test:browser": "node project/test-scenarios.mjs core",
        "test:network": "node project/test-scenarios.mjs network",
        "test:availability": "node project/test-scenarios.mjs availability",
        "test:scenarios": "node project/test-scenarios.mjs all",
        "test:rollback-demo": "node project/test-scenarios.mjs demo",
        "test:rollback-live": "node project/test-scenarios.mjs live",
        "benchmark:interpolation": "npm run build && node modules/interpolation/scripts/benchmark.mjs",
        "benchmark:presentation": "npm run build && node modules/presentation-events/scripts/benchmark.mjs",
        "benchmark:rollback": "node modules/rollback/scripts/benchmark.mjs",
        "benchmark:rollback-primitives": "node modules/deterministic/scripts/primitives-benchmark.mjs",
        "benchmark:rally": "node modules/rollback/scripts/rally-benchmark.mjs",
        "serve:rollback-group": "node modules/transport/scripts/group-browser-serve.mjs",
        "serve:rollback-demo": "node modules/rollback/scripts/demo-serve.mjs",
        "test:audio": "node project/test-scenarios.mjs audio",
        "test:execution": "node project/test-scenarios.mjs execution",
        "test:consumer": "node project/test-scenarios.mjs consumer",
        "test:room": "node project/test-scenarios.mjs room",
        "build:previews": "node project/previews.mjs",
        "verify:release": "node project/release.mjs",
        "test:previews": "node project/test-scenarios.mjs previews",
        "prebuild": "npm run check"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@xmldom/xmldom": "0.9.12",
        "animejs": "4.5.0",
        "esbuild": "0.28.2",
        "eslint": "10.13.0",
        "globals": "16.5.0",
        "playwright": "1.63.0",
        "prettier": "3.9.10",
        "three": "0.186.1"
    }
}
